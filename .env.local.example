# Copy this file to `.env.local` (which is git-ignored) and fill in the values.
# Get these from: Supabase Dashboard → Project Settings → API
#
# SECURITY:
#   - NEVER commit `.env.local`
#   - NEVER paste these values into AI chat
#   - The "Secret key" bypasses RLS — server-side only

# ----- Project URL ----------------------------------------------------
# Dashboard label: "Project URL" (or "REST API URL" — same value, with /rest/v1 stripped)
# Format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# ----- Publishable key (safe to expose to the browser) ----------------
# Dashboard label: "Publishable key"  (formerly "anon / public")
# Format (new):  sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Format (old):  eyJhbGciOi...   ← JWT, still supported
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# ----- Secret key (SERVER ONLY — bypasses RLS) ------------------------
# Dashboard label: "Secret key"  (formerly "service_role")
# Format (new):  sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Format (old):  eyJhbGciOi...
# NEVER prefix this with NEXT_PUBLIC_  and NEVER ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# ----- Demo tenant fixtures (UUIDs are not secrets) -------------------
DEMO_TENANT_A=00000000-0000-0000-0000-000000000001
DEMO_TENANT_B=00000000-0000-0000-0000-000000000002

# ----- Unsubscribe token signing --------------------------------------
# A random secret for HMAC-SHA256 signing of unsubscribe links.
# Generate with: openssl rand -hex 32
# If not set, a temporary session-specific secret is generated (dev only).
UNSUBSCRIBE_SECRET=REPLACE_WITH_RANDOM_32_BYTE_HEX
